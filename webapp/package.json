{
  "name": "@janggi/webapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "pnpm checks && pnpm compile",
    "compile": "tsc --noEmit && vite build",
    "generate-icon": "node scripts/generate-icon.mjs",
    "preview": "vite preview",
    "checks": "pnpm lint && pnpm format:check && pnpm type-check && pnpm test",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --max-warnings=0 --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@janggi/shared": "workspace:*",
    "@reduxjs/toolkit": "2.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "9.3.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.18.10",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
