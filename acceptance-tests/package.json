{
  "name": "@janggi/acceptance-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm checks",
    "checks": "pnpm lint && pnpm format:check && pnpm type-check && pnpm test",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --max-warnings=0 --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "install-browsers": "playwright install chromium",
    "acceptance-tests": "playwright test",
    "acceptance-tests:bot-games": "playwright test --config playwright.bot-games.config.ts",
    "acceptance-tests:pwa": "playwright test --config playwright.pwa.config.ts",
    "acceptance-tests:local": "WEBAPP_URL=http://localhost:3000 playwright test",
    "acceptance-tests:production": "WEBAPP_URL=https://janggi.neilarmstrong.dev/ playwright test",
    "acceptance-tests:headed": "playwright test --headed",
    "acceptance-tests:ui": "playwright test --ui",
    "acceptance-tests:report": "playwright show-report"
  },
  "dependencies": {
    "@janggi/shared": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
